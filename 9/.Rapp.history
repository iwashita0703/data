library(ggplot2)#
#
df_raw <- read.csv("gakusyuu.csv", header = TRUE, fileEncoding = "UTF-8")#
df_raw$就職率 <- as.numeric(df_raw$就職率)#
df <- df_raw[!is.na(df_raw$就職率), ]#
#
# PNG 出力開始#
png("Class12_rp12-4A_YY.png", width = 1200, height = 800)#
#
# ここで必ず print() を使う（VSCode や RStudio で必要になる）#
print(#
  ggplot(df, aes(x = 学科名, y = 就職率)) +#
    geom_col(fill = "skyblue") +#
    theme(axis.text.x = element_text(angle = 90, hjust = 1, size = 6)) +#
    labs(#
      title = "学科別の就職率（令和8年3月卒）",#
      x = "学科名",#
      y = "就職率（％）"#
    )#
)#
#
dev.off()
