source("kadai2.R")
poster <- read.csv("Poster.csv", fileEncoding="UTF-8-BOM")#
#
# 1. Quartz デバイスを開く（画面に描画）#
quartz(width=7, height=7, family="Hiragino Sans")#
#
plot(poster$Nendo, poster$Netsu,#
     col=ifelse(poster$Hinshitsu=="ryou","blue","red"),#
     pch=ifelse(poster$Hinshitsu=="ryou",16,17),#
     xlab="粘度 (Nendo)",#
     ylab="熱処理時間 (Netsu)",#
     main="品質分類：粘度 × 熱処理時間")#
#
legend("topleft", legend=c("良品","不良品"),#
       col=c("blue","red"), pch=c(16,17))#
#
# 2. Quartz の内容を PDF に保存#
quartz.save("Class10_rp16-29B_scatter_YY.pdf", type="pdf")#
#
# 3. デバイスを閉じる#
dev.off()
