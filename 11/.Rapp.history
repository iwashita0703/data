# データ読み込み#
hyouka <- read.table("hyouka.csv", header = TRUE, sep = ",")#
#
# 6列だけ使用（complaints〜advance）#
hyouka6 <- hyouka[, 1:6]#
#
# 列名を英語に統一#
colnames(hyouka6) <- c("complaints", "privileges", "learning",#
                       "raises", "critical", "advance")#
#
# 主成分分析（標準化あり）#
hyouka_pca <- prcomp(hyouka6, scale = TRUE)#
#
# --- 17-1B：主成分負荷量（loadings） ---#
hyouka_pca$rotation
