conveni <- read.table("conveni.csv", header=TRUE, sep=",")#
hage <- read.table("hage.csv", header=TRUE, sep=",")#
test_data <- read.table("test.csv", header=TRUE, sep=",")#
#
# ==========================================#
# 【課題 15-2A・15-3A】 散布図と単回帰分析#
# ==========================================#
# 4つのグラフを1つのPDFに出力する設定#
pdf("Class08_rp15-2A_3A_YY.pdf")#
par(mfrow=c(2,2)) # 2行2列で表示#
#
expl_vars <- colnames(conveni)[2:5] # 説明変数(X1〜X4)#
y_var <- conveni$uriage_hyakuman    # 目的変数(Y)#
#
for (i in expl_vars) {#
  x_var <- conveni[[i]]#
  plot(y_var ~ x_var, main=paste("Uriage vs", i), xlab=i, ylab="Uriage")#
  # 単回帰分析の実行と直線の追加 [3, 7]#
  res <- lm(y_var ~ x_var)#
  abline(res)#
  # 回帰式と寄与率の表示 [3]#
  r2 <- summary(res)$r.squared#
  mtext(sprintf("y = %.2f x + %.2f", res$coefficients[8], res$coefficients[9]), side=3, line=1, cex=0.7)#
  mtext(sprintf("R^2 = %.4f", r2), side=3, line=0, cex=0.7)#
}#
dev.off()
pdf("Class08_rp15-2A_3A_YY.pdf")#
par(mfrow=c(2,2))  # 2行2列で表示#
#
expl_vars <- colnames(conveni)[2:5]  # 説明変数 X1〜X4#
y_var <- conveni$uriage_hyakuman     # 目的変数 Y#
#
for (i in expl_vars) {#
  x_var <- conveni[[i]]#
  # 散布図#
  plot(x_var, y_var,#
       main = paste("Uriage vs", i),#
       xlab = i, ylab = "Uriage")#
  # 単回帰#
  res <- lm(y_var ~ x_var)#
  abline(res, col="blue")#
  # 回帰式の係数（切片・傾き）#
  a <- res$coefficients[1]  # 切片#
  b <- res$coefficients[2]  # 傾き#
  # 寄与率 R^2#
  r2 <- summary(res)$r.squared#
  # 左上座標を自動取得#
  usr <- par("usr")#
  x_left <- usr[1] + (usr[2] - usr[1]) * 0.02#
  y_top  <- usr[4] - (usr[4] - usr[3]) * 0.05#
  # 回帰式と R^2 を左上に表示#
  text(x_left, y_top,#
       sprintf("y = %.2f x + %.2f", b, a),#
       adj = c(0,1), cex = 0.8)#
  text(x_left, y_top - (usr[4] - usr[3]) * 0.07,#
       sprintf("R^2 = %.4f", r2),#
       adj = c(0,1), cex = 0.8)#
}#
#
dev.off()
pdf("Class08_rp15-2A_3A_YY.pdf")#
par(mfrow=c(2,2))  # 2行2列で表示#
#
expl_vars <- colnames(conveni)[2:5]  # 説明変数 X1〜X4#
y_var <- conveni$uriage_hyakuman     # 目的変数 Y#
#
for (i in expl_vars) {#
  x_var <- conveni[[i]]#
  # 散布図（タイトルなし）#
  plot(x_var, y_var,#
       main = "",   # ← タイトルを消す#
       xlab = i, ylab = "Uriage")#
  # 単回帰#
  res <- lm(y_var ~ x_var)#
  abline(res, col="blue")#
  # 回帰式の係数#
  a <- res$coefficients[1]  # 切片#
  b <- res$coefficients[2]  # 傾き#
  # R^2#
  r2 <- summary(res)$r.squared#
  # タイトル位置（上部中央）に表示#
  mtext(sprintf("y = %.2f x + %.2f    |    R^2 = %.4f", b, a, r2),#
        side = 3, line = 0.5, cex = 0.8)#
}#
#
dev.off()
pdf("Class08_rp15-2A_3A_YY.pdf")#
par(mfrow=c(2,2))  # 2行2列で表示#
#
expl_vars <- colnames(conveni)[2:5]  # 説明変数 X1〜X4#
y_var <- conveni$uriage_hyakuman     # 目的変数 Y#
#
for (i in expl_vars) {#
  x_var <- conveni[[i]]#
  # 散布図（タイトルなし）#
  plot(x_var, y_var,#
       main = "",   # ← タイトルを消す#
       xlab = i, ylab = "Uriage")#
  # 単回帰#
  res <- lm(y_var ~ x_var)#
  abline(res, col="blue")#
  # 回帰式の係数#
  a <- res$coefficients[1]  # 切片#
  b <- res$coefficients[2]  # 傾き#
  # R^2#
  r2 <- summary(res)$r.squared#
  # タイトル位置に縦に表示#
  mtext(sprintf("y = %.2f x + %.2f", b, a),#
        side = 3, line = 1.0, cex = 0.8)#
  mtext(sprintf("R^2 = %.4f", r2),#
        side = 3, line = 0.0, cex = 0.8)#
}#
#
dev.off()
