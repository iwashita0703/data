conveni <- read.table("conveni.csv", header=TRUE, sep=",")#
hage <- read.table("hage.csv", header=TRUE, sep=",")#
test_data <- read.table("test.csv", header=TRUE, sep=",")#
#
pdf("Class08_rp15-2A_3A_YY.pdf")#
#
par(mfrow=c(2,2))  # 2行2列#
#
expl_vars <- colnames(conveni)[2:5]   # X1〜X4#
y_var <- conveni$uriage_hyakuman      # Y#
#
for (i in expl_vars) {#
  x_var <- conveni[[i]]#
  # 散布図のみ#
  plot(x_var, y_var,#
       main = "",#
       xlab = i,#
       ylab = "Uriage")#
}#
#
dev.off()
source("kadai.R")
